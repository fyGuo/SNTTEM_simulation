+   #                    df$L0*(df$A0-df$ps0)*(((1-df$A1)/(1-df$ps1))^(1-df$I1)*(df$Y2-gamma12(df$L1, psi12)*df$A1-df$mu12) + df$mu12-gamma02(df$L0,psi02)*df$A0-df$mu02),
